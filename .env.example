# Frontend API path
VITE_API_BASE_URL=/api

# Server-only secrets — never prefix these with VITE_
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_COMPLETION_TOKENS=1024
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=DevPilot AI

# Neon Postgres pooled connection string (server-only)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
REQUIRE_AUTH=true

# Comma-separated accounts promoted to administrator after registration/login
ADMIN_EMAILS=
