# Frontend Firebase web configuration (safe public identifiers, not service-account secrets)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Frontend API path
VITE_API_BASE_URL=/api
VITE_ENABLE_DEMO_AUTH=true

# Server-only secrets — never prefix these with VITE_
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=DevPilot AI

# Neon Postgres pooled connection string (server-only)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
REQUIRE_AUTH=false

# Firebase Admin token verification and admin user directory
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
