rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    match /users/{userId} { allow read, create, update: if owner(userId); allow delete: if false; }
    match /users/{userId}/{document=**} { allow read, write: if owner(userId); }
    match /publicPrompts/{promptId} { allow read: if signedIn(); allow write: if false; }
    // Written and queried only by trusted Firebase Admin backend code.
    match /aiRequests/{requestId} { allow read, write: if false; }
  }
}
