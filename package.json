{
  "name": "devpilot-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "2.13.0",
    "@hookform/resolvers": "5.2.1",
    "@monaco-editor/react": "4.7.0",
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.12.2",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dompurify": "3.2.6",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "firebase": "12.16.0",
    "firebase-admin": "13.5.0",
    "framer-motion": "12.42.2",
    "helmet": "8.1.0",
    "jspdf": "3.0.3",
    "lucide-react": "0.545.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.62.0",
    "react-hot-toast": "2.6.0",
    "react-icons": "5.5.0",
    "react-is": "19.2.8",
    "react-markdown": "10.1.0",
    "react-redux": "9.2.0",
    "react-router-dom": "7.18.1",
    "recharts": "3.10.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "9.2.1",
    "eslint": "9.35.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.5",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "vite": "8.1.5"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,json,css,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,mjs}": [
      "eslint --fix"
    ]
  }
}
