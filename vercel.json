{
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth?action=:action" },
    { "source": "/api/openrouter/models", "destination": "/api/openrouter" },
    { "source": "/api/openrouter/stream", "destination": "/api/openrouter" },
    { "source": "/api/admin/overview", "destination": "/api/admin" },
    { "source": "/api/data/:resource/:id", "destination": "/api/data?resource=:resource&id=:id" },
    { "source": "/api/data/:resource", "destination": "/api/data?resource=:resource" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
